# Ethereum mainnet RPC URL (e.g. Alchemy/Infura/QuickNode, or a public one)
RPC_URL=https://ethereum-rpc.publicnode.com
# Optional WebSocket RPC URL for instant block subscriptions
# RPC_WS_URL=wss://ethereum-rpc.publicnode.com

# 32-byte hex master encryption key for encrypting private keys at rest (auto-generated in data/master.key if unset)
# MASTER_ENCRYPTION_KEY=

# Port the backend + frontend serve on
PORT=3000

# Public origin used in links inside merchant emails (defaults to http://localhost:PORT)
# PUBLIC_BASE_URL=https://pay.example.com

# Admin console at /admin. If unset, a long random key is generated at
# data/admin.key on first start. If you set it, use at least 32 characters.
# ADMIN_SECRET_KEY=
# How long an admin login stays valid (default 12 hours, max 168).
# ADMIN_SESSION_HOURS=12

# Port the cafe storefront serves on, and where MSU Pay lives
CAFE_PORT=3001
MSUPAY_URL=http://localhost:3000
# Merchant company code used in the cafe's payment links (register on /register)
CAFE_COMPANY_CODE=NESPCFE

# Private key of YOUR main account that receives forwarded funds (no 0x needed)
MAIN_PRIVATE_KEY=

# How many block confirmations to wait before forwarding
CONFIRMATIONS=3

# Polling interval when watching an address (ms)
POLL_INTERVAL_MS=3000

# Block explorer API used to resolve the sender (for refunds). Etherscan-compatible.
# EXPLORER_API_URL=https://eth.blockscout.com

# Secret used to sign payment links (auto-generated & persisted if unset).
# PAYINFO_SECRET=

# API key required by /api/sign for non-authenticated callers (e.g. the cafe).
# The cafe server sends it as x-sign-key; keep it server-side only. If unset,
# one is generated and persisted at data/sign.key.
# SIGN_API_KEY=

# Optional demo merchant. Disabled unless SEED_DEMO_ACCOUNT=1 and both
# credentials below are set (password must be 12+ characters).
# SEED_DEMO_ACCOUNT=1
# SEED_DEMO_EMAIL=demo@example.com
# SEED_DEMO_PASSWORD=change-me-to-something-long

# Lifetime for merchant bearer tokens and pending invoices.
# TOKEN_TTL_DAYS=30
# INVOICE_TTL_MINUTES=60

# Cafe server -> MSU Pay signing key (defaults to SIGN_API_KEY or data/sign.key).
# MSUPAY_SIGN_KEY=

# Allow webhooks to localhost/private IPs (development only; enables SSRF).
# ALLOW_PRIVATE_WEBHOOKS=1

# Set when running behind a reverse proxy so rate limiting sees client IPs
# (e.g. TRUST_PROXY=1 for one proxy hop, or a subnet/CIDR).
# TRUST_PROXY=1

# Bitcoin / Litecoin API endpoints (mempool.space instances by default).
# BTC_API_URL=https://mempool.space/api
# LTC_API_URL=https://litecoinspace.org/api

# Gas tip (gwei) and limit for the forward transaction
GAS_PRICE_GWEI=
FORWARD_GAS_LIMIT=21000
